diff --git a/plugins/platforms/feishu/feishu_topic_follow.py b/plugins/platforms/feishu/feishu_topic_follow.py
new file mode 100644
index 0000000000..34458d4d1a
--- /dev/null
+++ b/plugins/platforms/feishu/feishu_topic_follow.py
@@ -0,0 +1,155 @@
+"""Feishu topic follow: answer a group @mention inside a new topic, then keep answering in it.
+
+Mixed into ``FeishuAdapter``. Two opt-in switches under ``platforms.feishu.extra`` (each
+overridable on a ``group_rules`` entry):
+
+- ``thread_reply``: a top-level group message that triggers the bot gets its reply in a new
+  topic. A short in-thread acknowledgement opens the topic before the turn runs, so the first
+  turn already belongs to the topic's session instead of the group's.
+- ``thread_follow``: inside a topic this bot owns, follow-ups need no @mention. A message that
+  @mentions someone else (a colleague, another bot) is left to them.
+
+Ownership is read from the topic itself — the first bot-authored message in it — so it survives
+gateway restarts without a state file, and a bot @mentioned once in another bot's topic answers
+that message without taking the topic over.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import uuid
+from typing import Any, Optional
+
+from agent.i18n import t
+
+logger = logging.getLogger(__name__)
+
+# Messages scanned for the first bot reply; a topic with more human messages before any bot reply
+# is treated as unowned.
+_OWNER_SCAN_PAGE_SIZE = 50
+_OWNER_CACHE_MAX = 4096
+
+
+class FeishuTopicFollowMixin:
+    """Topic opening and no-@ follow-ups for ``FeishuAdapter`` (needs its client/send helpers)."""
+
+    def _init_topic_follow_state(self) -> None:
+        # thread_id -> owned by this bot. Only settled answers are cached: a topic no bot has
+        # answered yet is asked again, since this bot may still become its owner.
+        self._topic_owner_cache: dict[str, bool] = {}
+
+    def _topic_option(self, chat_id: str, key: str) -> bool:
+        from plugins.platforms.feishu.adapter import _to_boolean
+
+        extra = getattr(getattr(self, "config", None), "extra", None) or {}
+        rules = extra.get("group_rules")
+        rule = rules.get(chat_id) if isinstance(rules, dict) and chat_id else None
+        if isinstance(rule, dict) and key in rule:
+            return _to_boolean(rule[key])
+        return _to_boolean(extra.get(key, False))
+
+    def _remember_topic_owner(self, thread_id: str, owned: bool) -> None:
+        cache = self._topic_owner_cache
+        if thread_id not in cache and len(cache) >= _OWNER_CACHE_MAX:
+            cache.pop(next(iter(cache)))
+        cache[thread_id] = owned
+
+    async def _open_reply_topic(self, chat_id: str, message_id: str) -> Optional[str]:
+        """Open a topic on a group message with an in-thread acknowledgement; return its id.
+
+        ``None`` (switch off, or Feishu refused) keeps the ordinary in-group reply.
+        """
+        if not self._topic_option(chat_id, "thread_reply") or not self._client:
+            return None
+        payload = json.dumps({"text": t("platform.feishu.topic.opened")}, ensure_ascii=False)
+        body = self._build_reply_message_body(
+            content=payload, msg_type="text", reply_in_thread=True, uuid_value=str(uuid.uuid4()),
+        )
+        request = self._build_reply_message_request(message_id, body)
+        try:
+            response = await self._run_blocking(self._client.im.v1.message.reply, request)
+        except Exception as exc:
+            logger.warning("[Feishu] Could not open a topic on %s: %s", message_id, exc, exc_info=True)
+            return None
+        thread_id = self._extract_response_field(response, "thread_id")
+        if not thread_id:
+            logger.warning(
+                "[Feishu] Could not open a topic on %s: [%s] %s", message_id,
+                getattr(response, "code", "?"), getattr(response, "msg", "no thread_id returned"),
+            )
+            return None
+        self._remember_topic_owner(thread_id, True)
+        return thread_id
+
+    async def _topic_follow_admits(self, sender: Any, message: Any) -> bool:
+        """Admit a topic message that was rejected only for lacking an @mention of this bot."""
+        from plugins.platforms.feishu.adapter import _is_bot_sender
+
+        chat_id = getattr(message, "chat_id", "") or ""
+        thread_id = getattr(message, "thread_id", None)
+        if (not thread_id or getattr(message, "chat_type", "p2p") == "p2p" or _is_bot_sender(sender)
+                or not self._topic_option(chat_id, "thread_follow")):
+            return False
+        # The mention gate and the group policy share one reject reason: re-check the policy.
+        if not self._allow_group_message(getattr(sender, "sender_id", None), chat_id):
+            return False
+        # Any @mention left here is of someone else: an @ of this bot (or @all) was admitted.
+        if getattr(message, "mentions", None):
+            return False
+        return await self._topic_owned_by_self(thread_id)
+
+    async def _topic_owned_by_self(self, thread_id: str) -> bool:
+        cached = self._topic_owner_cache.get(thread_id)
+        if cached is not None:
+            return cached
+        owner = await self._first_bot_sender_in_topic(thread_id)
+        if owner is None:
+            return False
+        owned = owner == self._app_id
+        self._remember_topic_owner(thread_id, owned)
+        return owned
+
+    async def _first_bot_sender_in_topic(self, thread_id: str) -> Optional[str]:
+        """App id of the first bot-authored message in a topic; ``None`` if none or unreadable."""
+        if not self._client:
+            return None
+        from lark_oapi.api.im.v1 import ListMessageRequest
+
+        request = (
+            ListMessageRequest.builder().container_id_type("thread").container_id(thread_id)
+            .sort_type("ByCreateTimeAsc").page_size(_OWNER_SCAN_PAGE_SIZE).build()
+        )
+        try:
+            response = await self._run_blocking(self._client.im.v1.message.list, request)
+        except Exception as exc:
+            logger.warning("[Feishu] Could not read topic %s: %s", thread_id, exc, exc_info=True)
+            return None
+        if not self._response_succeeded(response):
+            logger.warning(
+                "[Feishu] Could not read topic %s: [%s] %s", thread_id,
+                getattr(response, "code", "?"), getattr(response, "msg", ""),
+            )
+            return None
+        for item in getattr(getattr(response, "data", None), "items", None) or []:
+            sender = getattr(item, "sender", None)
+            # GET/list report sender.id = app_id for bot messages; peer bots differ only there.
+            if getattr(sender, "sender_type", "") == "app":
+                return str(getattr(sender, "id", "") or "")
+        return None
+
+    async def _fetch_last_message_in_thread(self, thread_id: str) -> Optional[str]:
+        """Fetch the last message_id in a thread for reply-based routing."""
+        if not self._client or not thread_id:
+            return None
+        try:
+            from lark_oapi.api.im.v1 import ListMessageRequest
+            request = ListMessageRequest.builder().container_id_type("thread").container_id(thread_id).page_size(1).build()
+            response = await self._run_blocking(self._client.im.v1.message.list, request)
+            if self._response_succeeded(response):
+                items = getattr(getattr(response, "data", None), "items", None)
+                if items and len(items) > 0:
+                    return getattr(items[0], "message_id", None)
+        except Exception as exc:
+            logger.debug("[Feishu] Failed to fetch last message in thread %s: %s", thread_id, exc)
+        return None
diff --git a/tests/gateway/test_feishu_topic_follow.py b/tests/gateway/test_feishu_topic_follow.py
new file mode 100644
index 0000000000..b8d8f9701a
--- /dev/null
+++ b/tests/gateway/test_feishu_topic_follow.py
@@ -0,0 +1,235 @@
+"""Feishu topic follow: a group @mention is answered in a new topic, and inside a topic the bot
+owns, follow-ups need no @mention.
+
+Behaviour contracts:
+- ``thread_reply`` opens the topic before the turn runs, so the first turn's source already
+  carries the topic's ``thread_id`` (one session for the whole topic).
+- ``thread_follow`` admits an un-mentioned topic message only when the first bot reply in that
+  topic is this bot's; a message @mentioning someone else, a sender the group policy rejects, and
+  a bot sender stay rejected.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from tests.gateway.feishu_helpers import install_dedup_state, make_adapter_skeleton, make_sender
+
+APP_ID = "cli_me"
+PEER_APP_ID = "cli_peer"
+
+
+class _FakeMessageApi:
+    """Stands in for ``client.im.v1.message``: records reply/list requests."""
+
+    def __init__(self, *, thread_id="omt_new", reply_ok=True, topic_senders=()):
+        self.replies = []
+        self.lists = []
+        self._thread_id = thread_id
+        self._reply_ok = reply_ok
+        self._topic_senders = list(topic_senders)
+
+    def reply(self, request):
+        self.replies.append(request)
+        data = SimpleNamespace(thread_id=self._thread_id, message_id="om_ack")
+        return SimpleNamespace(success=lambda: self._reply_ok, data=data, code=0 if self._reply_ok else 230001,
+                               msg="ok" if self._reply_ok else "denied")
+
+    def list(self, request):
+        self.lists.append(request)
+        items = [SimpleNamespace(message_id=f"om_{i}", sender=SimpleNamespace(sender_type=kind, id=sid))
+                 for i, (kind, sid) in enumerate(self._topic_senders)]
+        return SimpleNamespace(success=lambda: True, data=SimpleNamespace(items=items))
+
+
+def _wire_client(adapter, api):
+    adapter._client = SimpleNamespace(im=SimpleNamespace(v1=SimpleNamespace(message=api)))
+
+    async def _run_blocking(func, *args):
+        return func(*args)
+
+    adapter._run_blocking = _run_blocking
+
+
+# --- Opening a topic for a group reply ----------------------------------------------------------
+
+
+def _inbound_adapter(extra, api):
+    from plugins.platforms.feishu.adapter import FeishuAdapter
+
+    adapter = FeishuAdapter.__new__(FeishuAdapter)
+    adapter.config = PlatformConfig(extra=extra)
+    adapter._app_id = APP_ID
+    adapter._bot_open_id, adapter._bot_user_id, adapter._bot_name = "ou_me", "", "Hermes"
+    adapter._init_topic_follow_state()
+    adapter._download_feishu_message_resources = AsyncMock(return_value=([], []))
+    adapter._fetch_message_text = AsyncMock(return_value=None)
+    adapter.get_chat_info = AsyncMock(return_value={"name": "Team"})
+    adapter._resolve_sender_profile = AsyncMock(return_value={"user_id": "u1", "user_name": "Neo", "user_id_alt": None})
+    adapter._resolve_source_chat_type = Mock(return_value="group")
+    adapter.build_source = Mock(side_effect=lambda **kw: SimpleNamespace(**kw))
+    adapter._dispatch_inbound_event = AsyncMock()
+    _wire_client(adapter, api)
+    return adapter
+
+
+def _run_inbound(adapter, *, chat_type="group", chat_id="oc_team", thread_id=None):
+    message = SimpleNamespace(
+        content=json.dumps({"text": "look at this"}), message_type="text", message_id="om_user",
+        mentions=[], chat_id=chat_id, parent_id=None, upper_message_id=None, root_id=None, thread_id=thread_id,
+    )
+    asyncio.run(adapter._process_inbound_message(
+        data=message, message=message, sender_id=None, chat_type=chat_type, message_id="om_user",
+    ))
+    return adapter.build_source.call_args.kwargs["thread_id"]
+
+
+def test_thread_reply_opens_a_topic_before_the_turn_and_routes_the_turn_into_it():
+    api = _FakeMessageApi(thread_id="omt_new")
+    adapter = _inbound_adapter({"thread_reply": True}, api)
+
+    assert _run_inbound(adapter) == "omt_new"
+    (request,) = api.replies
+    assert request.message_id == "om_user"
+    assert request.request_body.reply_in_thread is True
+    assert json.loads(request.request_body.content)["text"]
+    # The topic this bot opened is its own without asking Feishu.
+    assert asyncio.run(adapter._topic_owned_by_self("omt_new")) is True
+    assert api.lists == []
+
+
+@pytest.mark.parametrize("extra", [
+    {},
+    {"thread_reply": False},
+    {"thread_reply": True, "group_rules": {"oc_team": {"policy": "open", "thread_reply": False}}},
+])
+def test_no_topic_when_thread_reply_is_off_for_the_chat(extra):
+    api = _FakeMessageApi()
+    adapter = _inbound_adapter(extra, api)
+
+    assert _run_inbound(adapter) is None
+    assert api.replies == []
+
+
+def test_group_rule_turns_thread_reply_on_for_one_chat():
+    api = _FakeMessageApi(thread_id="omt_rule")
+    adapter = _inbound_adapter({"group_rules": {"oc_team": {"policy": "open", "thread_reply": "true"}}}, api)
+
+    assert _run_inbound(adapter, chat_id="oc_team") == "omt_rule"
+    assert _run_inbound(adapter, chat_id="oc_other") is None
+
+
+@pytest.mark.parametrize("kwargs", [{"chat_type": "p2p"}, {"thread_id": "omt_existing"}])
+def test_dm_and_existing_topic_messages_never_open_a_topic(kwargs):
+    api = _FakeMessageApi()
+    adapter = _inbound_adapter({"thread_reply": True}, api)
+
+    assert _run_inbound(adapter, **kwargs) == kwargs.get("thread_id")
+    assert api.replies == []
+
+
+def test_refused_topic_falls_back_to_an_ordinary_group_reply():
+    api = _FakeMessageApi(reply_ok=False)
+    adapter = _inbound_adapter({"thread_reply": True}, api)
+
+    assert _run_inbound(adapter) is None
+    adapter._dispatch_inbound_event.assert_awaited_once()
+
+
+# --- Following up inside an owned topic without @mention ----------------------------------------
+
+
+def _follow_adapter(api, *, extra=None, group_policy="open"):
+    adapter = make_adapter_skeleton(group_policy=group_policy)
+    adapter._app_id = APP_ID
+    adapter.config = PlatformConfig(extra={"thread_follow": True} if extra is None else extra)
+    adapter._init_topic_follow_state()
+    install_dedup_state(adapter)
+    _wire_client(adapter, api)
+    adapter._process_inbound_message = AsyncMock()
+    return adapter
+
+
+_n = iter(range(10_000))
+
+
+def _deliver(adapter, *, thread_id: str | None = "omt_1", mentions=None, sender=None):
+    message = SimpleNamespace(
+        message_id=f"om_in_{next(_n)}", chat_type="group", chat_id="oc_team", thread_id=thread_id,
+        mentions=mentions, content="", message_type="text",
+    )
+    adapter._process_inbound_message.reset_mock()
+    asyncio.run(adapter._handle_message_event_data(
+        SimpleNamespace(event=SimpleNamespace(sender=sender or make_sender(open_id="ou_neo"), message=message))
+    ))
+    return adapter._process_inbound_message.await_count == 1
+
+
+def test_unmentioned_message_in_own_topic_is_admitted_and_ownership_is_cached():
+    api = _FakeMessageApi(topic_senders=[("user", "ou_neo"), ("app", APP_ID)])
+    adapter = _follow_adapter(api)
+
+    assert _deliver(adapter) is True
+    assert _deliver(adapter) is True
+    assert len(api.lists) == 1
+
+
+def test_topic_owned_by_another_bot_stays_with_it_after_this_bot_was_mentioned_once():
+    # Y answered first; X was @mentioned later and replied once. The topic is still Y's.
+    api = _FakeMessageApi(topic_senders=[("user", "ou_neo"), ("app", PEER_APP_ID), ("app", APP_ID)])
+    adapter = _follow_adapter(api)
+
+    assert _deliver(adapter) is False
+
+
+def test_message_mentioning_someone_else_is_left_to_them():
+    api = _FakeMessageApi(topic_senders=[("app", APP_ID)])
+    adapter = _follow_adapter(api)
+    colleague = SimpleNamespace(key="@_user_1", id=SimpleNamespace(open_id="ou_colleague", user_id=None), name="Ann")
+
+    assert _deliver(adapter, mentions=[colleague]) is False
+    assert api.lists == []
+
+
+def test_topic_no_bot_has_answered_yet_is_not_followed_and_is_asked_again():
+    api = _FakeMessageApi(topic_senders=[("user", "ou_neo")])
+    adapter = _follow_adapter(api)
+
+    assert _deliver(adapter) is False
+    assert _deliver(adapter) is False
+    assert len(api.lists) == 2
+
+
+@pytest.mark.parametrize("extra", [
+    {},
+    {"thread_follow": True, "group_rules": {"oc_team": {"policy": "open", "thread_follow": False}}},
+])
+def test_follow_off_for_the_chat_keeps_the_mention_requirement(extra):
+    api = _FakeMessageApi(topic_senders=[("app", APP_ID)])
+    adapter = _follow_adapter(api, extra=extra)
+
+    assert _deliver(adapter) is False
+
+
+def test_group_policy_still_gates_follow_ups():
+    api = _FakeMessageApi(topic_senders=[("app", APP_ID)])
+    adapter = _follow_adapter(api, group_policy="allowlist")  # empty allowlist: nobody may trigger
+
+    assert _deliver(adapter) is False
+    assert api.lists == []
+
+
+def test_bot_senders_and_plain_group_messages_are_not_followed():
+    api = _FakeMessageApi(topic_senders=[("app", APP_ID)])
+    adapter = _follow_adapter(api)
+    adapter._allow_bots = "all"
+    adapter._bot_open_id = "ou_me"
+
+    assert _deliver(adapter, sender=make_sender(sender_type="bot", open_id="ou_peer")) is False
+    assert _deliver(adapter, thread_id=None) is False
